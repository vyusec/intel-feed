FROM node:22-bookworm-slim
RUN useradd -m -u 10001 zoli \
    && mkdir /input /work \
    && find / -xdev -type f -perm /6000 -exec chmod a-s {} +
COPY deploy/sandbox/execute-npm.sh /usr/local/bin/execute.sh
COPY deploy/sandbox/npm-lock.cjs /usr/local/bin/npm-lock.cjs
COPY deploy/sandbox/monitor.sh /usr/local/bin/monitor.sh
RUN chmod 755 /usr/local/bin/execute.sh /usr/local/bin/monitor.sh
USER zoli
ENTRYPOINT ["/usr/local/bin/monitor.sh"]
