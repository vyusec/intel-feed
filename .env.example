# Copy to .env and generate credentials locally; do not commit .env.
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://zoli:replace-with-a-random-password@db:5432/zoli?sslmode=disable
ZOLI_OPERATOR_TOKEN=replace-with-at-least-32-random-characters
ZOLI_RUNNER_TOKEN=replace-with-another-32-random-characters
# Optional authenticated GitHub API requests and hosted client lookup keys.
GITHUB_TOKEN=
ZOLI_API_KEYS=
